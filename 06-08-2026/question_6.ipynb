      "metadata": {},
      "outputs": [],
      "source": [
        "number = 5\n",
        "factorial = 1\n",
        "for i in range(1, number + 1):\n",
        "    factorial *= i\n",
        "print(\"Factorial =\", factorial)"
      ]
    }
