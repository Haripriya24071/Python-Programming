        "# 6. Count character frequency in a string."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "text = \"python\"\n",
        "freq = {}\n",
        "for char in text:\n",
        "    freq[char] = freq.get(char, 0) + 1\n",
        "print(\"Character frequency:\", freq)"
      ]
    }
  ],
