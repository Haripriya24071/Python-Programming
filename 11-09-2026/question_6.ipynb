        "# 6. Find the common elements of two tuples"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "t1 = (1, 2, 3, 4)\n",
        "t2 = (3, 4, 5, 6)\n",
        "common = set(t1) & set(t2)\n",
        "print(\"Common elements:\", list(common))"
      ]
