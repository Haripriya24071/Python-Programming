      "source": [
        "# 9. Find the union, intersection and difference of two sets"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "s1 = {1, 2, 3}\n",
        "s2 = {3, 4, 5}\n",
        "print(\"Union:\", s1 | s2)\n",
        "print(\"Intersection:\", s1 & s2)\n",
        "print(\"Difference (s1 - s2):\", s1 - s2)"
      ]
    }
  ],
