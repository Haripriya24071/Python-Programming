      "source": [
        "# 3. Count how many times a particular number occurs in a list"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "nums = [1, 2, 3, 2, 4, 2, 5]\n",
        "target = 2\n",
        "count = 0\n",
        "for n in nums:\n",
        "    if n == target:\n",
        "        count += 1\n",
        "print(\"Count of\", target, \"is:\", count)"
      ]
    }
  ],
  "metadata": {
    "language_info": {
      "name": "python"
    }
